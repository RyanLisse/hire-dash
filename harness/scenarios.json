[
  {
    "id": "vs0_source_create_read",
    "description": "Create source, list source, and read assistant status",
    "steps": [
      {"method": "POST", "path": "/api/sources", "body": {"name": "Harness Source", "platform": "x", "baseUrl": "https://example.org"}, "expectStatus": 201},
      {"method": "GET", "path": "/api/sources", "expectStatus": 200},
      {"method": "GET", "path": "/api/assistant/source-status", "expectStatus": 200},
      {"method": "GET", "path": "/api/tools/list-capabilities", "expectStatus": 200}
    ]
  },
  {
    "id": "vs1_ingest_search",
    "description": "Run source and search jobs",
    "steps": [
      {"method": "POST", "path": "/api/sources", "body": {"name": "Ingest Source", "platform": "remote", "baseUrl": "https://example.net"}, "expectStatus": 201},
      {"method": "POST", "path": "/api/sources/src_1/run", "expectStatus": 200},
      {"method": "GET", "path": "/api/jobs?q=Frontend", "expectStatus": 200}
    ]
  },
  {
    "id": "vs2_vs3_candidate_application_match",
    "description": "Candidate flow through grading and matching",
    "steps": [
      {"method": "POST", "path": "/api/candidates", "body": {"name": "Harness Candidate", "email": "hc@example.com", "resumeText": "React Node TypeScript"}, "expectStatus": 201},
      {"method": "POST", "path": "/api/candidates/cand_1/grade", "expectStatus": 200},
      {"method": "POST", "path": "/api/applications", "body": {"candidateId": "cand_1", "jobId": "job_src_1_1"}, "expectStatus": 201},
      {"method": "POST", "path": "/api/match", "body": {"candidateId": "cand_1", "jobId": "job_src_1_1"}, "expectStatus": 200},
      {"method": "PATCH", "path": "/api/applications/app_1/stage", "body": {"stage": "screening"}, "expectStatus": 200}
    ]
  },
  {
    "id": "vs4_ops_audit",
    "description": "Operational and audit visibility",
    "steps": [
      {"method": "GET", "path": "/api/ops/runs", "expectStatus": 200},
      {"method": "GET", "path": "/api/audit", "expectStatus": 200}
    ]
  }
]
